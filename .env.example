# ==============================================================================
# CARDSCAN - AUTOMATED GIFT CARD SCANNING PLATFORM
# Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Security Secrets (Must be rotated in production)
# Generate via: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-character-secret-key-in-production

# Server-Side Keyed HMAC Secret for 4-5 digit numeric customer PINs
# NEVER expose this key in database, frontend code, or logs!
PIN_HMAC_SECRET=replace-with-server-only-secret-for-pin-keyed-hmac-32bytes

# Session & Cookies
SESSION_COOKIE_NAME=cardscan_session
ADMIN_COOKIE_NAME=cardscan_admin_session
COOKIE_SECURE=false             # Set to true when serving behind HTTPS
COOKIE_SAMESITE=lax
SESSION_EXPIRY_MINUTES=30
ADMIN_SESSION_EXPIRY_HOURS=12

# Database Connection
# Local Development (SQLite): sqlite:///./cardscan.db
# Docker Compose / Production: postgresql+psycopg2://user:password@localhost:5432/cardscan
DATABASE_URL=sqlite:///./cardscan.db

# Storage Provider Configuration: "local" or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads

# S3-Compatible Object Storage (Required only if STORAGE_BACKEND=s3)
S3_BUCKET_NAME=cardscan-private-storage
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=               # Optional for MinIO / LocalStack / Cloudflare R2

# Rate Limiting Controls
PIN_MAX_FAILED_ATTEMPTS=5
PIN_LOCKOUT_SECONDS=60
ADMIN_LOGIN_MAX_FAILED=5
ADMIN_LOGIN_LOCKOUT_SECONDS=120

# Image Processing Controls
MAX_IMAGE_UPLOAD_BYTES=15728640  # 15 MB
ALLOWED_IMAGE_MIME_TYPES=["image/jpeg","image/png","image/webp"]

# CORS Allowed Origins (Comma-separated in frontend or list in JSON)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
