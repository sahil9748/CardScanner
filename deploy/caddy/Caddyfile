# CardScan Production Caddyfile - Automatic SSL & Reverse Proxy
{
    email {$ACME_EMAIL:admin@cardscan.local}
    admin off
}

{$DOMAIN:localhost} {
    # Response compression
    encode zstd gzip

    # Request body limit for high-resolution gift card image uploads (35 MB)
    request_body {
        max_size 35MB
    }

    # Route /api/ directly to FastAPI backend service
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Route all other traffic to Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
