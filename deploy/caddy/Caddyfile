# ==============================================================================
# CARDSCAN PRODUCTION CADDYFILE
# Universal Reverse Proxy - Compatible with Cloudflare CDN, Direct IP, & Domain
# ==============================================================================

{
    admin off
}

# HTTP Handler (Port 80)
# Serves application directly over HTTP, handles direct IP access,
# and supports Cloudflare "Flexible" SSL mode without redirect loops.
:80 {
    encode zstd gzip

    # Request body limit for high-resolution gift card scans (35 MB)
    request_body {
        max_size 35MB
    }

    # Route /api/ directly to FastAPI backend service
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Route all other traffic to Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}

# HTTPS Handler (Port 443)
# Explicitly matches 1scan.top, {$DOMAIN}, and fallback :443 with internal TLS
https://1scan.top, https://{$DOMAIN:localhost}, :443 {
    tls internal

    encode zstd gzip

    # Request body limit for high-resolution gift card scans (35 MB)
    request_body {
        max_size 35MB
    }

    # Route /api/ directly to FastAPI backend service
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Route all other traffic to Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
